# Required for Kolay Slack Bot
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
KOLAY_API_TOKEN=...

# Optional access control (leave blank = no restriction)
# Comma-separated Slack channel IDs (e.g. C0123456,C0654321)
ALLOWED_CHANNEL_IDS=

# Comma-separated Slack user IDs (e.g. U0123456,U0654321)
ALLOWED_USER_IDS=
