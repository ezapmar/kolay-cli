# Kolay IK Slack Bot — copy to .env and fill in values
# Run `kolay-slack-setup` to generate this interactively.

# ── Required ──────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...      # api.slack.com/apps → Basic Information → Signing Secret
KOLAY_API_TOKEN=...

# ── Combined mode (kolay-combined) — MCP + Slack in one process ───────────────
# SLACK_APP_TOKEN is NOT needed in HTTP/combined mode; only needed for Socket Mode.
# SLACK_APP_TOKEN=xapp-...

# ── Access control (Option C) — leave blank to allow everyone ─────────────────
# Comma-separated Slack channel IDs (e.g. C0123456,C0654321)
ALLOWED_CHANNEL_IDS=

# Comma-separated Slack user IDs (e.g. U0123456,U0654321)
ALLOWED_USER_IDS=

# ── MCP server (only needed in combined mode) ──────────────────────────────────
MCP_API_KEY=          # optional — protects /mcp endpoint
PORT=8000             # default port
