# ── Kolay AI Box ────────────────────────────────────────────────────
# Copy this file:  cp .env.example .env
# Then edit .env with your values.

# ── LLM Model ──────────────────────────────────────────────────────
# gemma4:e4b   → laptop / CPU / demo       (~6 GB VRAM, Q4)
# gemma4:26b   → PoC / production default  (~17 GB VRAM, Q4, MoE, fast)
# gemma4:31b   → max quality               (~20 GB VRAM, Q4, dense)
# qwen2.5:32b  → fallback if Gemma 4 tool-calling is insufficient
OLLAMA_MODEL=gemma4:26b

# ── Kolay IK API Token ────────────────────────────────────────────
# Two modes:
#
# Mode A — Per-user tokens (recommended, default):
#   Leave this empty. Each user pastes their own token in chat on first login.
#   Token is validated against Kolay IK and stored per-user.
#
# Mode B — Global token (single-tenant / team deployments):
#   Set this to a shared Kolay IK token.
#   All users skip onboarding and share this token's permissions.
#
# Get your token: Kolay IK > Settings > API Tokens
KOLAY_API_TOKEN=

# ── Security ───────────────────────────────────────────────────────
KOLAY_SECURITY_PROFILE=standard

# ── Admin Account ─────────────────────────────────────────────────────────
# Created automatically on first boot.
# This is the superuser account that manages the Open WebUI instance.
ADMIN_EMAIL=admin@kolay.box
ADMIN_PASS=change-me-min-8-chars
ADMIN_NAME=Admin

# ── Open WebUI ────────────────────────────────────────────
WEBUI_PORT=3000
WEBUI_SECRET_KEY=change-me-to-a-long-random-string
